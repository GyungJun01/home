# Claude API Key (필수)
# 1. https://console.anthropic.com/ 에 로그인
# 2. Settings > API Keys 로 이동
# 3. "Create Key" 클릭하여 새 키 생성
# 4. 아래에 발급받은 키를 붙여넣기
#
# 형식: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 주의: 이 키는 절대 공개 저장소에 커밋하지 마세요!

ANTHROPIC_API_KEY=your_api_key_here
